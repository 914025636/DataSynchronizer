#
################## 应用数据库（低性能数据存储）
#
# 应用数据库主机地址
MYSQL_HOST=127.0.0.1
# 应用数据库端口
MYSQL_PORT=3306
# 应用数据库用户名
MYSQL_USER=root
# 应用数据库密码
MYSQL_PASS=789456
# 应用数据库名称
MYSQL_DB=stockml

#
################## 交易所数据库（高性能行情数据存储）
#
# 交易所数据库主机地址
MYSQL_HOST_EXCHANGE=127.0.0.1
# 交易所数据库端口
MYSQL_PORT_EXCHANGE=3306
# 交易所数据库用户名
MYSQL_USER_EXCHANGE=root
# 交易所数据库密码
MYSQL_PASS_EXCHANGE=789456
# 交易所数据库名称
MYSQL_DB_EXCHANGE=stockml_exchange

#
################## QuestDB 时序数据库
#
# QuestDB 主机地址
QUESTDB_HOST=127.0.0.1
# QuestDB 行协议连接协议
QUESTDB_PROTOCOL=tcp
# QuestDB 行协议写入端口
QUESTDB_PORT=9009
# QuestDB SQL 查询端口
QUESTDB_SQL_PORT=18812
# QuestDB 写入队列允许积压的最大记录数
QUESTDB_MAX_PENDING_WRITES=10000
# QuestDB 每批写入的最大记录数
QUESTDB_WRITE_BATCH_SIZE=5000
# QuestDB 定时刷新写入缓冲区的间隔（毫秒）
QUESTDB_FLUSH_INTERVAL_MS=1000
# QuestDB 刷新写入缓冲区的超时时间（毫秒）
QUESTDB_FLUSH_TIMEOUT_MS=10000

# Node.js 事件循环延迟检查间隔（毫秒）
EVENT_LOOP_CHECK_INTERVAL_MS=10000
# 事件循环延迟达到该值时记录警告（毫秒）
EVENT_LOOP_DELAY_WARNING_MS=1000
# CCXT WebSocket 错误统计时间窗口（毫秒）
CCXT_WEBSOCKET_ERROR_WINDOW_MS=30000
# CCXT WebSocket 重试的初始等待时间（毫秒）
CCXT_WEBSOCKET_RETRY_BASE_MS=1000
# CCXT WebSocket 重试的最大等待时间（毫秒）
CCXT_WEBSOCKET_RETRY_MAX_MS=30000
# CCXT WebSocket 重试等待时间的随机抖动比例
CCXT_WEBSOCKET_RETRY_JITTER=0.25
# CCXT 获取订单簿时请求的深度档位数
CCXT_ORDERBOOK_DEPTH=50

# CCXT REST/HTTPS 请求使用的可选代理地址
CCXT_HTTPS_PROXY=http://127.0.0.1:10808
# CCXT WebSocket 请求使用的可选代理地址
CCXT_WSS_PROXY=http://127.0.0.1:10808


#
################## Redis 数据库（提高服务间通信可靠性并降低延迟）
#
# Redis 主机地址
REDIS_HOST = 127.0.0.1
# Redis 服务端口
REDIS_PORT = 6380
# Redis 认证密码，留空表示不使用密码
REDIS_AUTH = 
# Redis 逻辑数据库编号
REDIS_DB_ID = 0
# Redis 行情 Stream 允许保留的最大消息数量
REDIS_MARKET_STREAM_MAX_LENGTH = 10000000
# 每次从 Redis 行情 Stream 读取的最大消息数量
REDIS_MARKET_STREAM_READ_COUNT = 2000
# Redis 行情 Stream 阻塞读取的最长等待时间（毫秒）
REDIS_MARKET_STREAM_BLOCK_MS = 2000

#
################## 快照心跳
#
# K 线和订单簿快照的保存间隔（毫秒），建议 60000（1 分钟）
snapshotHeartbeat = 60000
# 单个订单簿快照最多保留的价格档位数
ORDERBOOK_SIZE_LIMIT = 1024

# 日志级别，可选 verbose 或 info
logLevel = info
# 是否启用 Worker 调试日志（true=启用，false=关闭）
DEBUG_WORKER=false

#
################## 功能开关（1=开启，0=关闭）
#
# 是否启用市场数据采集
MarketData = 1
# 是否启用市场情绪数据采集
Sentiment = 1
# 是否启用实时成交数据流
Livefeed = 1
# 是否启用价格行情采集
PriceTicker = 1
# 是否启用 Warden 交易对监控与初始化
Warden = 1

#
################## 交易所
#
# 额外启用的行情采集交易所列表；watchPairs 使用的交易所会自动加载，Coinbase 仅支持现货
exchangeList = binance,okx,bybit

#
################# Warden 设置
#
# 自动初始化并采集的交易对列表，格式为“交易所-CCXT 统一交易对”，多个条目使用英文逗号分隔
# 示例：binance-BTC/USDT、okx-ETH/USDT、bybit-BTC/USDT:USDT、coinbase-BTC/USD
#
#BTC
#合约交易前五：binance-BTC/USDT:USDT,okx-BTC/USDT:USDT,bybit-BTC/USDT:USDT,mexc-BTC/USDT:USDT,gate-BTC/USDT:USDT
#现货交易前五：binance-BTC/USDT,mexc-BTC/USDT,coinbase-BTC/USD,whitebit-BTC/USDT,bybit-BTC/USDT
#ETH
# ETH永续交易前五 binance-ETH/USDT:USDT,okx-ETH/USDT:USDT,gate-ETH/USDT:USDT,coinbase-ETH/USDC:USDC,mexc-ETH/USDT:USDT
# ETH现货交易前五 binance-ETH/USDT,mexc-ETH/USDT,gate-ETH/USDT,bitmart-ETH/USDT,whitebit-ETH/USDT
watchPairs = binance-BTC/USDT,binance-BTC/USDT:USDT,binance-BTC/USDC,okx-BTC/USDT,okx-BTC/USDT:USDT,bybit-BTC/USDT,bybit-BTC/USDT:USDT

#
################# Reddit API
#
# Reddit 应用客户端 ID
reddit_clientId = 
# Reddit 应用客户端密钥
reddit_clientSecret = 
# Reddit 登录用户名
reddit_username = 
# Reddit 登录密码
reddit_password = 

# Reddit 数据更新循环间隔（秒），用于避免触发限流，建议至少 450
reddit_update_timeout = 900

#
################# Twitter API
#
# Twitter/X 应用 Consumer Key
consumerKey = 
# Twitter/X 应用 Consumer Secret
consumerSecret = 
# Twitter/X 用户访问令牌
accessToken = 
# Twitter/X 用户访问令牌密钥
accessTokenSecret = 

# Twitter/X 数据更新循环间隔（秒），用于避免触发限流，建议至少 450
twitter_update_timeout = 450

