#
################## Appliaction Database
#
# low performance database
#
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=789456
MYSQL_DB=stockml

#
################## Exchange Database
# Storage of exhcange datas / high performance database
#
MYSQL_HOST_EXCHANGE=127.0.0.1
MYSQL_PORT_EXCHANGE=3306
MYSQL_USER_EXCHANGE=root
MYSQL_PASS_EXCHANGE=789456
MYSQL_DB_EXCHANGE=stockml_exchange

#
################## QuestDB
#
QUESTDB_HOST=127.0.0.1
QUESTDB_PORT=9000

# Optional CCXT proxies for restricted exchange networks
CCXT_HTTPS_PROXY=http://127.0.0.1:10808
CCXT_WSS_PROXY=http://127.0.0.1:10808


#
################## Redis Database
# Redis can be used to increase reliability and reduce latency between services
#
REDIS_HOST = 127.0.0.1
REDIS_PORT = 6379
REDIS_AUTH = 
REDIS_DB_ID = 0

#
################## Snapshot Heartbeat
#
# Time (ms), between snapshot Candlestick,Orderbook
# Recommended: 60000 (1 minute)
#
snapshotHeartbeat = 60000
ORDERBOOK_SIZE_LIMIT = 1024

# Loglevel verbose,info
logLevel = info
DEBUG_WORKER=false

#
################## Functions
#
# On/Off (1 = On, 0 = Off)
MarketData = 1
Sentiment = 1
Livefeed = 1
PriceTicker = 1
Warden = 1

#
################## Exchanges
#
# Optional additional exchanges for market and ticker collection.
# Exchanges used by watchPairs are loaded automatically.
# Supported data feeds: binance,okx,bybit,coinbase
# Coinbase supports spot only.
exchangeList = binance,okx,bybit,mexc,gate,coinbase,whitebit
exchangeMarketTypes = binance:spot|swap,okx:swap,bybit:spot|swap,mexc:spot|swap,gate:swap,coinbase:spot,whitebit:spot

#
################# Warden settings
#
# Auto init exact CCXT unified symbols for data collection
# Format: exchange-symbol
# Examples: binance-BTC/USDT, okx-ETH/USDT, bybit-BTC/USDT:USDT, coinbase-BTC/USD
#
#BTC
#合约交易前五：binance-BTC/USDT:USDT,okx-BTC/USDT:USDT,bybit-BTC/USDT:USDT,mexc-BTC/USDT:USDT,gate-BTC/USDT:USDT
#现货交易前五：binance-BTC/USDT,mexc-BTC/USDT,coinbase-BTC/USD,whitebit-BTC/USDT,bybit-BTC/USDT
#ETH
# ETH永续交易前五 binance-ETH/USDT:USDT,okx-ETH/USDT:USDT,gate-ETH/USDT:USDT,coinbase-ETH/USDC:USDC,mexc-ETH/USDT:USDT
# ETH现货交易前五 binance-ETH/USDT,mexc-ETH/USDT,gate-ETH/USDT,bitmart-ETH/USDT,whitebit-ETH/USDT
watchPairs = binance-BTC/USDT:USDT,okx-BTC/USDT:USDT,bybit-BTC/USDT:USDT,mexc-BTC/USDT:USDT,gate-BTC/USDT:USDT,binance-BTC/USDT,mexc-BTC/USDT,coinbase-BTC/USD,whitebit-BTC/USDT,bybit-BTC/USDT

#
################# Reddit API
#
#
reddit_clientId = 
reddit_clientSecret = 
reddit_username = 
reddit_password = 

# Reddit api loop timeout, avoid rate limit! (in sec) (Recommend: 450)
#
reddit_update_timeout = 900

#
################# Twitter API
#
#
consumerKey = 
consumerSecret = 
accessToken = 
accessTokenSecret = 

