# QuestDB 配置
QUESTDB_HOST=localhost
QUESTDB_PROTOCOL=tcp
QUESTDB_PORT=9009
QUESTDB_SQL_HOST=localhost
QUESTDB_SQL_PORT=18812
QUESTDB_SQL_USER=admin
QUESTDB_SQL_PASSWORD=quest
QUESTDB_SQL_DATABASE=qdb

# 可选：CCXT 公共 REST 和 WebSocket 请求代理
# CCXT_HTTPS_PROXY=http://127.0.0.1:7890
# CCXT_WSS_PROXY=http://127.0.0.1:7890

# WebSocket 重连使用指数退避，并增加随机抖动以避免同时重连
CCXT_WEBSOCKET_RETRY_BASE_MS=1000
CCXT_WEBSOCKET_RETRY_MAX_MS=30000
CCXT_WEBSOCKET_RETRY_JITTER=0.25

# MySQL 配置（现有）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=password
MYSQL_DB=exchange_data

MYSQL_HOST_EXCHANGE=localhost
MYSQL_PORT_EXCHANGE=3306
MYSQL_USER_EXCHANGE=root
MYSQL_PASS_EXCHANGE=password
MYSQL_DB_EXCHANGE=exchange_data

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6380

# Redis Streams -> QuestDB Worker
REDIS_TRADE_STREAM=market:trades:v1
REDIS_ORDERBOOK_STREAM=market:orderbook:v1
REDIS_MARKET_STREAM_GROUP=questdb-writers-v1
# 每个 Worker 应使用唯一名称；默认使用 worker-PID
# REDIS_MARKET_STREAM_CONSUMER=worker-1
REDIS_MARKET_STREAM_MAX_LENGTH=10000000
REDIS_MARKET_STREAM_READ_COUNT=2000
REDIS_MARKET_STREAM_BLOCK_MS=2000
REDIS_STREAM_WARNING_LAG=10000
REDIS_STREAM_ERROR_LAG=50000
REDIS_STREAM_WARNING_AGE_MS=30000
REDIS_STREAM_ERROR_AGE_MS=120000
REDIS_STREAM_MONITOR_INTERVAL_MS=10000
REDIS_STREAM_ALERT_COOLDOWN_MS=60000
REDIS_STREAM_PENDING_IDLE_MS=30000

# 独立 Worker 模式：trades、orderbook 或 all
MARKET_STREAM_WORKER_MODE=all

# QuestDB Worker 批量写入
QUESTDB_MAX_PENDING_WRITES=10000
QUESTDB_WRITE_BATCH_SIZE=5000
QUESTDB_FLUSH_INTERVAL_MS=1000
QUESTDB_FLUSH_TIMEOUT_MS=10000

# 其他配置
ORDERBOOK_SIZE_LIMIT=1024
